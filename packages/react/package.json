{
  "name": "@flexboard/react",
  "version": "0.1.1",
  "description": "React adapter for the FlexBoard recursive split-layout engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@flexboard/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "react",
    "layout",
    "split-layout",
    "panel",
    "drag-and-drop",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y0UNGBLUD/flexboard.git",
    "directory": "packages/react"
  },
  "license": "MIT"
}
